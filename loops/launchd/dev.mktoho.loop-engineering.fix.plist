<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.mktoho.loop-engineering.fix</string>

	<key>ProgramArguments</key>
	<array>
		<string>/Users/mktoho/work/ai/loop-engineering/loops/run-scheduled.sh</string>
		<string>fix</string>
	</array>

	<!-- 30分ごと（毎時 0 分・30 分）に起動。
	     オープン Issue がなければ数秒で終わる（トークン消費ゼロ）。

	     実測（11回）の所要時間は中央値 6.4分・最長 44.1分。長い実行は
	     次の起動と重なるが、fix-loop.sh 側が worktree とブランチの存在で
	     処理済み Issue をスキップし、run-scheduled.sh の PID ロックが
	     同種ループの二重起動を防ぐため、同じ Issue を二重に触ることはない。

	     これ以上短くしないこと。15分間隔にすると長時間の実行が常に重なり、
	     node_modules を共有した状態での並行ビルド（.next / dist / turbo
	     キャッシュ）を踏むことになる。そこは検証していない。 -->
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Minute</key>
			<integer>0</integer>
		</dict>
		<dict>
			<key>Minute</key>
			<integer>30</integer>
		</dict>
	</array>

	<!-- スリープ等で起動を逃した場合、復帰時に1回だけ実行する。 -->
	<key>RunAtLoad</key>
	<false/>

	<key>StandardOutPath</key>
	<string>/Users/mktoho/work/ai/loop-engineering/loops/logs/launchd-fix.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/mktoho/work/ai/loop-engineering/loops/logs/launchd-fix.log</string>

	<key>WorkingDirectory</key>
	<string>/Users/mktoho/work/ai/loop-engineering/loops</string>

	<!-- launchd は最小限の環境しか渡さない。PATH と認証まわりは
	     run-scheduled.sh 側で整えるが、HOME と USER はここで確実に渡す。 -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/mktoho</string>
		<key>USER</key>
		<string>mktoho</string>
		<key>LANG</key>
		<string>ja_JP.UTF-8</string>
	</dict>

	<!-- claude 側の CLAUDE_TIMEOUT=2700（45分）が先に効き、その外側の保険として
	     ここを 3000（50分）にする。順序が逆だと launchd が先に SIGKILL を送り、
	     生ログもループ側の後片付け（worktree の削除）も走らないまま終わる。
	     CLAUDE_TIMEOUT を変えるときは、必ずこちらもそれより大きく保つこと。 -->
	<key>ExitTimeOut</key>
	<integer>3000</integer>

	<key>ProcessType</key>
	<string>Background</string>

	<!-- 低優先度で動かし、対話作業の邪魔をしない。 -->
	<key>Nice</key>
	<integer>5</integer>
</dict>
</plist>
