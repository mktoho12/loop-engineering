<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.mktoho.loop-engineering.discover</string>

	<key>ProgramArguments</key>
	<array>
		<string>/Users/mktoho/work/ai/loop-engineering/loops/run-scheduled.sh</string>
		<string>discover</string>
	</array>

	<!-- 毎時 30 分に起動。修正ループ（毎時 0 分）と 30 分ずらして、
	     main の pull や worktree の操作が競合しないようにする。
	     HEAD が変わらず全観点を一巡していれば数秒で終わる（トークン消費ゼロ）。 -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Minute</key>
		<integer>30</integer>
	</dict>

	<key>RunAtLoad</key>
	<false/>

	<key>StandardOutPath</key>
	<string>/Users/mktoho/work/ai/loop-engineering/loops/logs/launchd-discover.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/mktoho/work/ai/loop-engineering/loops/logs/launchd-discover.log</string>

	<key>WorkingDirectory</key>
	<string>/Users/mktoho/work/ai/loop-engineering/loops</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/mktoho</string>
		<key>USER</key>
		<string>mktoho</string>
		<key>LANG</key>
		<string>ja_JP.UTF-8</string>
	</dict>

	<key>ExitTimeOut</key>
	<integer>2400</integer>

	<key>ProcessType</key>
	<string>Background</string>

	<key>Nice</key>
	<integer>5</integer>
</dict>
</plist>
